+// ExtendBlobRetention is retried too: maintenance renews every blob's object lock (--extend-object-locks), one
+// request per blob, and a single transient error (SlowDown, timeout, 5xx) otherwise fails the whole run. Retrying is
+// safe: each attempt sets the retention from the current time, so it only ends a little later.
+func (s retryingStorage) ExtendBlobRetention(ctx context.Context, id blob.ID, opts blob.ExtendOptions) error {
+	return retry.WithExponentialBackoffNoValue(ctx, "ExtendBlobRetention("+string(id)+")", func() error {
+		return s.Storage.ExtendBlobRetention(ctx, id, opts)
+	}, isRetriable)
+}
+
 // NewWrapper returns a Storage wrapper that adds retry loop around all operations of the underlying storage.
 func NewWrapper(wrapped blob.Storage) blob.Storage {
 	return &retryingStorage{Storage: wrapped}
