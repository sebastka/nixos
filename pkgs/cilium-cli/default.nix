{
  fetchurl,
  stdenv,
  lib,
  installShellFiles,
}:

let
  version = "0.20.2";
  assets = {
    x86_64-linux = {
      arch = "amd64";
      hash = "sha256-tyJKYr/tDoTxqEVn0nT+/FAX33apNuBnxCASu3/DCFY=";
    };
    aarch64-linux = {
      arch = "arm64";
      hash = "sha256-kir5yXfngVAOuWxRE35JVAmxzdJIyeG3//uGPmtu/fg=";
    };
  };
  asset =
    assets.${stdenv.hostPlatform.system}
      or (throw "cilium-cli: unsupported platform ${stdenv.hostPlatform.system}");
in
stdenv.mkDerivation {
  pname = "cilium-cli";
  inherit version;
  src = fetchurl {
    url = "https://github.com/cilium/cilium-cli/releases/download/v${version}/cilium-linux-${asset.arch}.tar.gz";
    inherit (asset) hash;
  };
  sourceRoot = ".";
  installPhase = ''
    install -m755 -D cilium $out/bin/cilium
    runHook postInstall
  '';
  nativeBuildInputs = [ installShellFiles ];
  # zsh completion, generated by the binary itself (only when it runs on the build machine)
  postInstall = lib.optionalString (stdenv.buildPlatform.canExecute stdenv.hostPlatform) ''
    export HOME="$TMPDIR"
    installShellCompletion --cmd cilium --zsh <($out/bin/cilium completion zsh)
  '';
  meta = {
    description = "CLI to install, manage and troubleshoot Kubernetes clusters running Cilium";
    homepage = "https://github.com/cilium/cilium-cli";
    platforms = builtins.attrNames assets;
  };
}
